@using Microsoft.AspNetCore.Identity
@using TechSupportRagBot.Models
@using TechSupportRagBot.Services
@inject UserManager<ApplicationUser> UserManager
@inject AccessProfileService Access
@{
    var account = await UserManager.GetUserAsync(User);
    var profileKey = account is null ? AccessProfileService.Observer : await Access.ResolveProfileKeyAsync(account);
    var profiles = await Access.GetProfilesAsync();
    var permissions = profiles.FirstOrDefault(profile => profile.Key == profileKey)?.Permissions
        ?? new Dictionary<string, bool>();
    bool Can(string permission) => permissions.TryGetValue(permission, out var allowed) && allowed;
    var isInternal = User.IsInRole("Admin") || User.IsInRole("Operator");
    var hasClient = account?.ClientId is not null;
    var isAdmin = User.IsInRole("Admin");
    string T(string key) => UiText.T(Context, key);
    var items = new List<(string Group, string Page, string Label, string Icon)>();
    items.Add((T("SidebarWork"), "/Index", T("Overview"), "ce-dashboard"));
    if (isInternal && Can("Tickets")) items.Add((T("SidebarWork"), "/Admin/Tickets", T("AllTickets"), "ce-inbox"));
    if (isInternal && Can("OperatorQueue")) items.Add((T("SidebarWork"), "/Operator/Index", T("OperatorQueue"), "ce-chat"));
    if (hasClient && Can("ClientCabinet")) items.Add((T("SidebarWork"), "/Client/Tickets", T("MyTickets"), "ce-inbox"));
    if (hasClient && Can("CreateTickets")) items.Add((T("SidebarWork"), "/Client/NewTicket", T("NewTicket"), "ce-plus"));

    if (isInternal && Can("ManageClients")) items.Add((T("SidebarClientsEquipment"), "/Admin/Clients", T("Clients"), "ce-clients"));
    if (isInternal && Can("ManageMachines")) items.Add((T("SidebarClientsEquipment"), "/Admin/Machines", T("Equipment"), "ce-machine"));
    if (isInternal && Can("ManageLicenses")) items.Add((T("SidebarClientsEquipment"), "/Admin/Licenses", T("Licenses"), "ce-license"));
    if (hasClient && Can("ClientCabinet")) items.Add((T("SidebarClientsEquipment"), "/Client/Machines", T("MyEquipment"), "ce-machine"));
    if (hasClient && Can("ClientCabinet")) items.Add((T("SidebarClientsEquipment"), "/Client/Activate", T("Activation"), "ce-license"));
    if (hasClient && Can("CompanyUsers")) items.Add((T("SidebarClientsEquipment"), "/Client/Users", T("CompanyUsers"), "ce-users"));

    if (isInternal && Can("ManageAdmins")) items.Add((T("Team"), "/Admin/Admins", T("Employees"), "ce-users"));
    if (isInternal && Can("TimeTracking")) items.Add((T("Team"), "/Admin/TimeTracking", T("TimeTracking"), "ce-clock"));
    if (isInternal && Can("AccessProfiles")) items.Add((T("Team"), "/Admin/AccessProfiles", T("AccessProfiles"), "ce-shield"));

    if (isInternal && Can("QA")) items.Add((T("SidebarKnowledgeAi"), "/Admin/QA", "QA", "ce-knowledge"));
    if (isInternal && Can("QA")) items.Add((T("SidebarKnowledgeAi"), "/Admin/IndexedChats", T("IndexedChats"), "ce-check"));
    if (isInternal && Can("QA")) items.Add((T("SidebarKnowledgeAi"), "/Admin/BotTest", T("BotTest"), "ce-bot"));
    if (isInternal && Can("Settings")) items.Add((T("SidebarKnowledgeAi"), "/Admin/ApiStatistics", T("ApiStatisticsNav"), "ce-chart"));

    if (isInternal && Can("Settings")) items.Add((T("System"), "/Admin/Settings", T("Settings"), "ce-settings"));
    if (isAdmin && Can("Settings")) items.Add((T("System"), "/Admin/WorkCalendar", T("WorkCalendar"), "ce-calendar"));
    items.Add((T("System"), "/Profile", T("MyProfile"), "ce-user"));
    var currentPage = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    string? lastGroup = null;
}
<nav class="dispatch-navigation">
    @foreach (var item in items)
    {
        if (item.Group != lastGroup)
        {
            lastGroup = item.Group;
            <div class="dispatch-nav-group">@item.Group</div>
        }
        var active = currentPage.Equals(item.Page, StringComparison.OrdinalIgnoreCase)
            || (item.Page == "/Profile" && currentPage.Equals("/ProfileEdit", StringComparison.OrdinalIgnoreCase))
            || (item.Page == "/Operator/Index" && currentPage.Equals("/Operator/Ticket", StringComparison.OrdinalIgnoreCase))
            || (item.Page == "/Client/Tickets" && currentPage.Equals("/Client/Ticket", StringComparison.OrdinalIgnoreCase));
        <a class="dispatch-nav-link @(active ? "active" : null)" asp-page="@item.Page" aria-current="@(active ? "page" : null)">
            <svg class="dispatch-icon" aria-hidden="true"><use href="#@item.Icon"></use></svg>
            <span>@item.Label</span>
        </a>
    }
</nav>
<form class="dispatch-sidebar-signout" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
    <button type="submit">@TechSupportRagBot.Services.UiText.T(Context, "Logout", "Выйти")</button>
</form>
