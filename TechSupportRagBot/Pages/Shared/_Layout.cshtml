@inject TechSupportRagBot.Services.BrowserPushService PushService
<!DOCTYPE html>
<html lang="@(Context.Request.Cookies["lang"] == "en" ? "en" : "ru")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Class Engineering Support</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/class-engineering-mark-32.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script>try{const theme=localStorage.getItem('classeng-theme');if(theme==='dark'){document.documentElement.dataset.theme='dark';document.documentElement.dataset.bsTheme='dark'}}catch{}</script>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/dispatch.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/dark.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/privacy-push.css" asp-append-version="true" />
</head>
<body class="dispatch-theme @(User.Identity?.IsAuthenticated == true ? "dispatch-signed-in" : "dispatch-guest")">
    <a class="skip-to-content" href="#main-content">@TechSupportRagBot.Services.UiText.T(Context, "SkipToContent")</a>
    <partial name="_IconSprite" />
    <div class="dispatch-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="dispatch-sidebar" id="dispatch-sidebar" aria-label="@TechSupportRagBot.Services.UiText.T(Context, "Navigation")">
                <a class="dispatch-brand" asp-page="/Index" aria-label="Class Engineering Support">
                    <span class="dispatch-brand-mark"><img src="/images/class-engineering-transparent.png" alt="" /></span>
                    <span class="dispatch-brand-name"><strong>CLASS / SERVICE</strong><small>@TechSupportRagBot.Services.UiText.T(Context, "SupportCenter")</small></span>
                </a>
                <partial name="_Sidebar" />
            </aside>
            <button class="dispatch-sidebar-backdrop" type="button" data-sidebar-close tabindex="-1" aria-label="@TechSupportRagBot.Services.UiText.T(Context, "CloseMenu")"></button>
        }
        <div class="dispatch-content">
            <header class="dispatch-header">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="dispatch-menu-toggle" type="button" data-sidebar-toggle aria-controls="dispatch-sidebar" aria-expanded="false" aria-label="@TechSupportRagBot.Services.UiText.T(Context, "Menu", "Открыть меню")">
                        <svg class="dispatch-icon" aria-hidden="true"><use href="#ce-menu"></use></svg>
                    </button>
                }
                else
                {
                    <a class="dispatch-guest-brand" asp-page="/Index"><img src="/images/class-engineering-transparent.png" alt="" /><span>CLASS <small>engineering</small></span></a>
                }
                <div class="dispatch-header-title">@(ViewData["Title"] ?? TechSupportRagBot.Services.UiText.T(Context, "Support", "Поддержка"))</div>
                <partial name="_LoginPartial" />
            </header>
            <div class="app-container">
                <main id="main-content" role="main">@RenderBody()</main>
            </div>
            <footer class="app-footer">
                <span>© 2026 Class Engineering</span>
                <a asp-page="/Privacy">@TechSupportRagBot.Services.UiText.T(Context, "PrivacyPolicy")</a>
                <button type="button" data-cookie-settings>@TechSupportRagBot.Services.UiText.T(Context, "CookieSettings")</button>
                <small class="app-version">1.1.4</small>
            </footer>
        </div>
    </div>

    <aside class="cookie-banner" data-cookie-banner hidden aria-label="@TechSupportRagBot.Services.UiText.T(Context, "CookieSettings")">
        <p>@TechSupportRagBot.Services.UiText.T(Context, "CookieNotice") <a asp-page="/Privacy">@TechSupportRagBot.Services.UiText.T(Context, "PrivacyPolicy")</a></p>
        <div class="cookie-actions">
            <button type="button" data-cookie-choice="reject">@TechSupportRagBot.Services.UiText.T(Context, "CookieReject")</button>
            <button type="button" data-cookie-choice="accept">@TechSupportRagBot.Services.UiText.T(Context, "CookieAccept")</button>
        </div>
    </aside>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" asp-page="/Push" data-push-form data-public-key="@PushService.PublicKey"
              data-enable="@TechSupportRagBot.Services.UiText.T(Context, "PushEnable")"
              data-disable="@TechSupportRagBot.Services.UiText.T(Context, "PushDisable")"
              data-enabled="@TechSupportRagBot.Services.UiText.T(Context, "PushEnabled")"
              data-disabled="@TechSupportRagBot.Services.UiText.T(Context, "PushDisabled")"
              data-unsupported="@TechSupportRagBot.Services.UiText.T(Context, "PushUnsupported")"
              data-denied="@TechSupportRagBot.Services.UiText.T(Context, "PushDenied")"
              data-error="@TechSupportRagBot.Services.UiText.T(Context, "PushError")" hidden>
            @Html.AntiForgeryToken()
        </form>
    }

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>window.ceText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TechSupportRagBot.Services.UiText.ClientStrings(Context)));</script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script src="/js/dispatch.js" asp-append-version="true"></script>
    <script src="/js/theme.js" asp-append-version="true"></script>
    <script src="/js/focus-lists.js" asp-append-version="true"></script>
    <script src="/js/cookie-consent.js" asp-append-version="true"></script>
    <script src="/js/push.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
