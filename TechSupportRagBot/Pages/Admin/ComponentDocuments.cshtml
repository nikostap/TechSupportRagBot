@page
@model TechSupportRagBot.Pages.Admin.ComponentDocumentsModel
@{
    Func<string, string> T = key => TechSupportRagBot.Services.UiText.T(HttpContext, key);
    ViewData["Title"] = T("ComponentDocuments");
}
<section class="page-head"><div><p class="eyebrow">@T("ComponentCatalog")</p><h1>@T("ComponentDocuments")</h1></div></section>
<nav class="component-tabs" aria-label="@T("ComponentCatalog")">
    <a asp-page="/Admin/Components" asp-route-tab="models">@T("ComponentModels")</a>
    <a asp-page="/Admin/Components" asp-route-tab="positions">@T("MachinePositions")</a>
    <a asp-page="/Admin/Components" asp-route-tab="configurations">@T("MachineConfigurations")</a>
    <a class="active" asp-page="/Admin/ComponentDocuments">@T("ComponentDocuments")</a>
    <a asp-page="/Admin/QA" asp-route-ScopeFilter="Component">@T("ComponentQA")</a>
</nav>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="component-layout">
    <section class="panel"><h2>@T("UploadDocument")</h2>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="component-form">
            <label>@T("ChooseFile")<input asp-for="Input.File" type="file" required /></label>
            <label>@T("DocumentKind")<select asp-for="Input.DocumentKind" required>
                <option value="">@T("ChooseDocumentKind")</option>
                <option value="MachineManual">@T("MachineManual")</option>
                <option value="ElectricalScheme">@T("ElectricalScheme")</option>
                <option value="PneumaticScheme">@T("PneumaticScheme")</option>
                <option value="ComponentManual">@T("ComponentManual")</option>
                <option value="ErrorCatalog">@T("ErrorCatalog")</option>
                <option value="SetupGuide">@T("SetupGuide")</option>
            </select></label>
            <label>@T("Name")<input asp-for="Input.Title" /></label>
            <label data-help="@T("DocumentScopeHelp")">@T("MachineModel")<select asp-for="Input.MachineModel"><option value="">@T("Any")</option>
                @foreach (var item in Model.MachineModels) { <option value="@item">@item</option> }
            </select></label>
            <label data-help="@T("DocumentScopeHelp")">@T("SpecificMachine")<select asp-for="Input.MachineId"><option value="">@T("Any")</option>
                @foreach (var item in Model.Machines) { <option value="@item.Id">@item.Name · @item.SerialNumber</option> }
            </select></label>
            <label data-help="@T("DocumentScopeHelp")">@T("ComponentModel")<select asp-for="Input.ComponentModelId"><option value="">@T("Any")</option>
                @foreach (var item in Model.Components.Where(x => !x.IsArchived)) { <option value="@item.Id">@item.Manufacturer @item.Series @item.PartNumber</option> }
            </select></label>
            <p>@T("DocumentDraftHint")</p>
            <button class="btn-main" type="submit">@T("UploadDocument")</button>
        </form>
    </section>
    <section class="panel" id="component-document-list" data-status-url="@Url.Page("/Admin/ComponentDocuments", "IndexStatus")" data-progress-label="@T("DocumentIndexProgress")"><h2>@T("ComponentDocuments")</h2>
        @if (Model.Documents.Count == 0) { <p>@T("NoDocuments")</p> }
        <div class="component-list">
        @foreach (var item in Model.Documents)
        {
            <article class="component-item"><strong>@(item.Title ?? item.OriginalFileName)</strong>
                <span>@T(item.DocumentKind) · @(item.AppliesToAllMachines ? T("AllMachines") : item.ComponentModel == null ? item.MachineModel : $"{item.ComponentModel.Manufacturer} {item.ComponentModel.PartNumber}")</span>
                <small>@(item.Status == "Retired" ? T("RetiredDocument") : item.ClientDownloadAllowed ? T("PublishedForClients") : T("NeedsConfirmation"))</small>
                <div class="document-index-state" data-index-id="@item.Id" data-index-status="@item.IndexStatus" aria-live="polite">
                    <strong data-index-label>@(Model.CanIndex(item) ? Model.IndexStatusText(item) : T("DocumentIndexDownloadOnly"))</strong>
                    @if (Model.CanIndex(item))
                    {
                        <span data-index-progress hidden="@(item.IndexStatus is not (TechSupportRagBot.Models.DocumentIndexStates.Processing or TechSupportRagBot.Models.DocumentIndexStates.Ready))">@T("DocumentIndexProgress"): @item.IndexCompletedChunks / @item.IndexTotalChunks</span>
                        <progress data-index-bar value="@item.IndexCompletedChunks" max="@Math.Max(1, item.IndexTotalChunks)" hidden="@(item.IndexStatus is not (TechSupportRagBot.Models.DocumentIndexStates.Processing or TechSupportRagBot.Models.DocumentIndexStates.Ready))"></progress>
                        <small data-index-error>@(item.IndexErrorCode == null ? "" : T(item.IndexErrorCode))</small>
                    }
                </div>
                @if (!item.ClientDownloadAllowed && item.Status != "Retired")
                {
                    <details><summary data-help="@T("DocumentEditHelp")">@T("EditCatalogEntry")</summary>
                        <form method="post" asp-page-handler="Update" asp-route-id="@item.Id" class="component-form">
                            <label>@T("Name")<input name="EditInput.Title" value="@item.Title" /></label>
                            <label>@T("DocumentKind")<select name="EditInput.DocumentKind" required>
                                @foreach (var kind in new[] { "MachineManual", "ElectricalScheme", "PneumaticScheme", "ComponentManual", "ErrorCatalog", "SetupGuide" })
                                { <option value="@kind" selected="@(item.DocumentKind == kind)">@T(kind)</option> }
                            </select></label>
                            <label data-help="@T("DocumentScopeHelp")">@T("MachineModel")<select name="EditInput.MachineModel"><option value="">@T("Any")</option>
                                @foreach (var modelName in Model.MachineModels) { <option value="@modelName" selected="@(item.MachineModel == modelName)">@modelName</option> }
                            </select></label>
                            <label data-help="@T("DocumentScopeHelp")">@T("SpecificMachine")<select name="EditInput.MachineId"><option value="">@T("Any")</option>
                                @foreach (var machine in Model.Machines) { <option value="@machine.Id" selected="@(item.MachineId == machine.Id)">@machine.Name · @machine.SerialNumber</option> }
                            </select></label>
                            <label data-help="@T("DocumentScopeHelp")">@T("ComponentModel")<select name="EditInput.ComponentModelId"><option value="">@T("Any")</option>
                                @foreach (var component in Model.Components) { <option value="@component.Id" selected="@(item.ComponentModelId == component.Id)">@component.Manufacturer @component.Series @component.PartNumber</option> }
                            </select></label>
                            <button class="btn-main" type="submit">@T("Save")</button>
                        </form>
                    </details>
                }
                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                    <button class="btn-secondary" type="submit" title="@T("DeleteDocumentHelp")">@T("Delete")</button>
                </form>
                @if (Model.CanPublish)
                {
                    @if (item.Status != "Retired" && !item.ClientDownloadAllowed && Model.CanIndex(item))
                    {
                        <form method="post" asp-page-handler="Index" asp-route-id="@item.Id">
                            <button class="btn-secondary" data-index-action type="submit" disabled="@(item.IndexStatus is TechSupportRagBot.Models.DocumentIndexStates.Queued or TechSupportRagBot.Models.DocumentIndexStates.Processing)">@T("IndexForBot")</button>
                        </form>
                    }
                    @if (item.Status != "Retired") { <form method="post" asp-page-handler="@(item.ClientDownloadAllowed ? "Revoke" : "Publish")" asp-route-id="@item.Id">
                        <button class="btn-secondary" data-publish-action type="submit" disabled="@(!item.ClientDownloadAllowed && !Model.CanPublishDocument(item))">@(item.ClientDownloadAllowed ? T("RevokeDocument") : T("PublishDocument"))</button>
                    </form> }
                }
            </article>
        }
        </div>
    </section>
</div>
<script src="~/js/component-help.js" asp-append-version="true" defer></script>
<script src="~/js/component-document-status.js" asp-append-version="true" defer></script>
