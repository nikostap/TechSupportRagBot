@page
@model TechSupportRagBot.Pages.Admin.MonthlyPasswordsModel
@using TechSupportRagBot.Services
@{
    ViewData["Title"] = UiText.T(HttpContext, "MonthlyPasswords");
}
<section class="page-head"><div><p class="eyebrow">@UiText.T(HttpContext, "Administration")</p><h1>@UiText.T(HttpContext, "MonthlyPasswords")</h1></div></section>
<form method="get" class="panel monthly-password-form">
    <div class="monthly-password-fields">
        <label>@UiText.T(HttpContext, "Model")
            <select name="ModelName" required>
                <option value="">@UiText.T(HttpContext, "SelectMachineModel")</option>
                @foreach (var option in Model.Models)
                {
                    <option value="@option" selected="@(string.Equals(Model.ModelName, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                }
            </select>
        </label>
        <label>@UiText.T(HttpContext, "SerialNumber")<input name="SerialNumber" value="@Model.SerialNumber" inputmode="numeric" maxlength="3" pattern="[0-9]{1,3}" required /></label>
        <label>@UiText.T(HttpContext, "Month")
            <select name="Month" required>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.Month == month)">@UiText.T(HttpContext, $"MonthName{month}")</option>
                }
            </select>
        </label>
        <label>@UiText.T(HttpContext, "Year")<input name="Year" type="number" min="1" max="9999" value="@Model.Year" required /></label>
    </div>
    <button class="btn-main" type="submit">@UiText.T(HttpContext, "GenerateMonthlyPassword")</button>
    @if (Model.ErrorKey != null) { <p class="text-danger monthly-password-error" role="alert">@UiText.T(HttpContext, Model.ErrorKey)</p> }
</form>
@if (Model.Result != null)
{
    <section class="panel monthly-password-result" role="status" aria-live="polite">
        <p class="eyebrow">@UiText.T(HttpContext, "MonthlyPasswordResult")</p>
        <strong class="monthly-password-value"><code>@Model.Result</code></strong>
        <p class="monthly-password-meta">@Model.ModelName · @Model.SerialNumber · @Model.ResultMonth</p>
    </section>
}
