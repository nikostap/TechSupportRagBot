@page
@model TechSupportRagBot.Pages.Admin.MonthlyPasswordsModel
@using TechSupportRagBot.Services
@{
    ViewData["Title"] = UiText.T(HttpContext, "MonthlyPasswords");
}
<section class="page-head"><div><p class="eyebrow">@UiText.T(HttpContext, "Administration")</p><h1>@UiText.T(HttpContext, "MonthlyPasswords")</h1></div></section>
<form method="get" class="panel">
    <label>@UiText.T(HttpContext, "Model")
        <select name="ModelId">
            <option value="">@UiText.T(HttpContext, "SelectMachineModel")</option>
            @foreach (var option in Model.Models)
            {
                <option value="@option.Id" selected="@(Model.ModelId == option.Id)">@option.Code</option>
            }
        </select>
    </label>
    <label>@UiText.T(HttpContext, "SerialNumber")<input name="SerialNumber" value="@Model.SerialNumber" inputmode="numeric" maxlength="3" pattern="[0-9]{1,3}" required /></label>
    <label>@UiText.T(HttpContext, "Year")<input name="Year" type="number" min="1" max="9999" value="@Model.Year" required /></label>
    <label>@UiText.T(HttpContext, "Month")<input name="Month" type="number" min="1" max="12" value="@Model.Month" required /></label>
    <button class="btn-main" type="submit">@UiText.T(HttpContext, "GenerateMonthlyPassword")</button>
    @if (Model.Result != null) { <p role="status">@UiText.T(HttpContext, "MonthlyPasswordResult"): <strong><code>@Model.Result</code></strong></p> }
    @if (Model.ErrorKey != null) { <p class="text-danger" role="alert">@UiText.T(HttpContext, Model.ErrorKey)</p> }
</form>
