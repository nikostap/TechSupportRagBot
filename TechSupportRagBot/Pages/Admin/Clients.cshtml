@page
@model TechSupportRagBot.Pages.Admin.ClientsModel
@{
    ViewData["Title"] = TechSupportRagBot.Services.UiText.T(HttpContext, "Clients", "Клиенты");
}

<section class="page-head">
    <div>
        <p class="eyebrow">@TechSupportRagBot.Services.UiText.T(HttpContext, "Administration", "Администрирование")</p>
        <h1>@TechSupportRagBot.Services.UiText.T(HttpContext, "Clients", "Клиенты")</h1>
    </div>
</section>

@if (TempData["IssuedPasswordOnce"] is string issuedPassword)
{
    <div class="panel"><strong>@TechSupportRagBot.Services.UiText.T(HttpContext, "OneTimePasswordNotice")</strong> @TempData["IssuedUserOnce"]: <code>@issuedPassword</code></div>
}
@if (TempData["ClientAutomationStatus"] is string automationStatus)
{
    <div class="panel" role="status">@automationStatus</div>
}

<div class="split-layout">
    <form method="post" class="panel">
        <h2>@TechSupportRagBot.Services.UiText.T(HttpContext, "NewClient", "Новый клиент")</h2>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "Company", "Компания")<input asp-for="Input.CompanyName" /></label>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "FullName", "ФИО пользователя")<input asp-for="Input.FullName" /></label>
        <p class="muted">@TechSupportRagBot.Services.UiText.T(HttpContext, "ClientLoginAuto", "Логин будет создан автоматически из названия компании и ФИО.")</p>
        <label>Email<input asp-for="Input.ContactEmail" /></label>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "Phone", "Телефон")<input asp-for="Input.ContactPhone" /></label>
        <button class="btn-main" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "CreateClient", "Создать клиента")</button>
        <div asp-validation-summary="All" class="text-danger"></div>
    </form>

    <div class="panel">
        <h2>@TechSupportRagBot.Services.UiText.T(HttpContext, "ClientAccounts", "Клиентские аккаунты")</h2>
        <div class="table-wrap">
            <table class="client-accounts-table">
                <thead>
                    <tr>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Company", "Компания")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "User", "Пользователь")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Username", "Логин")</th>
                        <th>Email</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Phone", "Телефон")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var client in Model.Clients)
                {
                    foreach (var user in client.Users)
                    {
                        <tr>
                            <td>@client.Name</td>
                            <td>@user.FullName</td>
                            <td><code>@user.UserName</code></td>
                            <td>@user.Email</td>
                            <td>@client.ContactPhone</td>
                            <td class="table-actions">
                                <a class="btn-secondary as-link" asp-page="/Admin/UserProfile" asp-route-id="@user.Id">@TechSupportRagBot.Services.UiText.T(HttpContext, "Profile", "Профиль")</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@client.Id" class="row-action">
                                    <button class="btn-danger" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "Delete", "Удалить")</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<section class="panel">
    <h2>@TechSupportRagBot.Services.UiText.T(HttpContext, "ClientList")</h2>
    @foreach (var client in Model.Clients)
    {
        <div class="panel">
            <h3>@client.Name</h3>
            <p>@TechSupportRagBot.Services.UiText.T(HttpContext, "Email"): @(client.ContactEmail ?? "—")</p>
            <h4>@TechSupportRagBot.Services.UiText.T(HttpContext, "MyEquipment")</h4>
            @{ var machineIds = client.ClientMachines.Select(x => x.MachineId)
                .Concat(client.Licenses.Select(x => x.MachineId)).Distinct().ToList(); }
            @if (machineIds.Count == 0)
            {
                <p class="muted">@TechSupportRagBot.Services.UiText.T(HttpContext, "ClientNoMachines")</p>
            }
            else
            {
                <div class="table-wrap"><table><thead><tr>
                    <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Machine")</th>
                    <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "ExpiresAt")</th>
                    <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "MonthlyPasswordStatus")</th>
                </tr></thead><tbody>
                @foreach (var id in machineIds)
                {
                    var machine = client.ClientMachines.FirstOrDefault(x => x.MachineId == id)?.Machine
                        ?? client.Licenses.FirstOrDefault(x => x.MachineId == id)?.Machine;
                    var license = client.Licenses.Where(x => x.MachineId == id && x.IsActive)
                        .OrderByDescending(x => x.ExpiresAt).FirstOrDefault();
                    var isLinked = client.ClientMachines.Any(x => x.MachineId == id);
                    var hasPassword = isLinked && machine != null && TechSupportRagBot.Services.MonthlyPasswordGenerator.TryForMachine(
                        machine, DateOnly.FromDateTime(DateTime.UtcNow.AddMonths(1)), Model.MonthlyPasswordModelIds, out _);
                    <tr>
                        <td>@machine?.Model @machine?.SerialNumber (@machine?.Name)</td>
                        <td>@(license?.ExpiresAt?.ToString("dd.MM.yyyy") ?? TechSupportRagBot.Services.UiText.T(HttpContext, "NoExpiry"))</td>
                        <td>@TechSupportRagBot.Services.UiText.T(HttpContext, !isLinked ? "NotActivated" : hasPassword ? "MonthlyPasswordReady" : "MonthlyPasswordUnavailable")</td>
                    </tr>
                }
                </tbody></table></div>
            }
            <form method="post" asp-page-handler="Automation">
                <input type="hidden" name="clientId" value="@client.Id" />
                <label><input type="checkbox" name="monthlyPasswordEmailEnabled" value="true" checked="@client.MonthlyPasswordEmailEnabled" />@TechSupportRagBot.Services.UiText.T(HttpContext, "MonthlyPasswordAutoEmail")</label>
                <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "MonthlyPasswordSendDay")<input type="number" name="monthlyPasswordSendDay" min="1" max="31" value="@client.MonthlyPasswordSendDay" required /></label>
                <p class="muted">@TechSupportRagBot.Services.UiText.T(HttpContext, "MonthlyPasswordSendHint")</p>
                <label><input type="checkbox" name="autoRenewSupportLicense" value="true" checked="@client.AutoRenewSupportLicense" />@TechSupportRagBot.Services.UiText.T(HttpContext, "AutoRenewSupportLicense")</label>
                <button class="btn-secondary" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "Save")</button>
            </form>
        </div>
    }
</section>
