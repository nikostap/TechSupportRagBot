@page
@model TechSupportRagBot.Pages.Admin.ComponentsModel
@{
    Func<string, string> T = key => TechSupportRagBot.Services.UiText.T(HttpContext, key);
    ViewData["Title"] = T("ComponentCatalog");
}
<section class="page-head"><div><p class="eyebrow">@T("Equipment")</p><h1>@T("ComponentCatalog")</h1></div></section>
<nav class="component-tabs" aria-label="@T("ComponentCatalog")">
    <a class="@(Model.Tab == "models" ? "active" : "")" asp-page="/Admin/Components" asp-route-tab="models">@T("ComponentModels")</a>
    <a class="@(Model.Tab == "positions" ? "active" : "")" asp-page="/Admin/Components" asp-route-tab="positions">@T("MachinePositions")</a>
    <a class="@(Model.Tab == "configurations" ? "active" : "")" asp-page="/Admin/Components" asp-route-tab="configurations">@T("MachineConfigurations")</a>
    <a asp-page="/Admin/ComponentDocuments">@T("ComponentDocuments")</a>
    <a asp-page="/Admin/QA" asp-route-ScopeFilter="Component">@T("ComponentQA")</a>
</nav>
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Tab == "models")
{
    <div class="component-layout">
        <section class="panel"><h2>@T("AddComponentModel")</h2>
            <form method="post" asp-page-handler="AddComponent" class="component-form">
                <label>@T("ComponentType")<input asp-for="Component.Type" required maxlength="80" /></label>
                <label>@T("Manufacturer")<input asp-for="Component.Manufacturer" required maxlength="120" /></label>
                <label>@T("Series")<input asp-for="Component.Series" maxlength="120" /></label>
                <label>@T("PartNumber")<input asp-for="Component.PartNumber" required maxlength="160" /></label>
                <label>@T("ComponentRating")<input asp-for="Component.Rating" /></label>
                <label>@T("Revision")<input asp-for="Component.Revision" maxlength="80" /></label>
                <label class="component-check"><input asp-for="Component.IsConfirmed" /> @T("ConfirmedData")</label>
                <button class="btn-main" type="submit">@T("Add")</button>
            </form>
        </section>
        <section class="panel"><h2>@T("ComponentModels")</h2>
            @if (Model.Components.Count == 0) { <p>@T("NoComponentModels")</p> }
            <div class="component-list">
                @foreach (var item in Model.Components)
                {
                    <article class="component-item"><strong>@item.Manufacturer @item.Series @item.PartNumber</strong>
                        <span>@item.Type · @item.Rating · @item.Revision</span>
                        <small>@(item.IsConfirmed ? T("ConfirmedData") : T("NeedsConfirmation"))</small></article>
                }
            </div>
        </section>
    </div>
}
else if (Model.Tab == "positions")
{
    <section class="panel component-template-panel"><h2>@T("PositionTemplates")</h2>
        <form method="post" asp-page-handler="AddTemplate" class="component-template-form">
            <label>@T("PositionName")<input asp-for="Template.Name" required maxlength="200" /></label>
            <label>@T("ComponentType")<input asp-for="Template.ComponentType" required maxlength="80" /></label>
            <button class="btn-secondary" type="submit">@T("AddTemplate")</button>
        </form>
        @if (Model.Templates.Count > 0)
        { <p>@string.Join(" · ", Model.Templates.Select(x => x.Name))</p> }
    </section>
    <div class="component-layout">
        <section class="panel"><h2>@T("AddMachinePosition")</h2>
            <form method="post" asp-page-handler="AddPosition" class="component-form">
                <label>@T("MachineModel")<select asp-for="Position.MachineModel" required><option value="">@T("SelectMachineModel")</option>
                    @foreach (var name in Model.MachineModels) { <option value="@name">@name</option> }
                </select></label>
                <label>@T("PositionTemplate")<select asp-for="Position.PositionTemplateId"><option value="">@T("NoTemplate")</option>
                    @foreach (var item in Model.Templates) { <option value="@item.Id">@item.Name · @item.ComponentType</option> }
                </select></label>
                <label>@T("PositionKey")<input asp-for="Position.Key" required maxlength="120" /></label>
                <label>@T("PositionName")<input asp-for="Position.Name" maxlength="200" /></label>
                <label>@T("ComponentType")<input asp-for="Position.ComponentType" maxlength="80" /></label>
                <label>@T("HmiLabel")<input asp-for="Position.HmiLabel" /></label>
                <label>@T("SchemeLabel")<input asp-for="Position.SchemeLabel" /></label>
                <button class="btn-main" type="submit">@T("Add")</button>
            </form>
        </section>
        <section class="panel"><h2>@T("MachinePositions")</h2>
            @if (Model.Positions.Count == 0) { <p>@T("NoMachinePositions")</p> }
            <div class="component-list">
                @foreach (var item in Model.Positions)
                { <article class="component-item"><strong>@item.MachineModel · @item.Name</strong><span>@item.Key · @item.HmiLabel · @item.SchemeLabel</span></article> }
            </div>
        </section>
    </div>
}
else
{
    <div class="component-layout">
        <section class="panel"><h2>@T("AssignComponent")</h2>
            <form method="post" asp-page-handler="Assign" class="component-form">
                <label>@T("MachineModel")<select asp-for="Assignment.MachineModel" required><option value="">@T("SelectMachineModel")</option>
                    @foreach (var name in Model.MachineModels) { <option value="@name">@name</option> }
                </select></label>
                <label>@T("MachinePosition")<select asp-for="Assignment.MachinePositionId" required><option value="">@T("SelectPosition")</option>
                    @foreach (var item in Model.Positions) { <option value="@item.Id" data-machine-model="@item.MachineModel">@item.MachineModel · @item.Name (@item.HmiLabel)</option> }
                </select></label>
                <label>@T("ComponentModel")<select asp-for="Assignment.ComponentModelId" required><option value="">@T("SelectComponent")</option>
                    @foreach (var item in Model.Components) { <option value="@item.Id">@item.Manufacturer @item.Series @item.PartNumber</option> }
                </select></label>
                <label>@T("SpecificMachineSerial")<input asp-for="Assignment.SpecificSerialNumber" maxlength="100" /></label>
                <small class="muted-text">@T("SpecificMachineSerialHelp")</small>
                <label>@T("SerialFrom")<input asp-for="Assignment.SerialFrom" type="number" min="0" max="999" /></label>
                <label>@T("SerialTo")<input asp-for="Assignment.SerialTo" type="number" min="0" max="999" /></label>
                <label class="component-check"><input asp-for="Assignment.IsConfirmed" /> @T("ConfirmedData")</label>
                <label class="component-check"><input asp-for="Assignment.ReplaceExisting" /> @T("ReplaceInstallation")</label>
                <button class="btn-main" type="submit">@T("Save")</button>
            </form>
        </section>
        <section class="panel"><h2>@T("MachineConfigurations")</h2>
            @if (Model.Installations.Count == 0) { <p>@T("NoConfigurations")</p> }
            <div class="component-list">
                @foreach (var item in Model.Installations)
                { <article class="component-item"><strong>@item.MachinePosition.MachineModel · @item.MachinePosition.Name</strong>
                    <span>@item.ComponentModel.Manufacturer @item.ComponentModel.Series @item.ComponentModel.PartNumber</span>
                    <small>@(item.SpecificSerialNumber ?? item.Machine?.SerialNumber ?? (item.SerialFrom is null ? T("ModelDefault") : $"{item.SerialFrom:000}–{item.SerialTo:000}")) · @(item.IsActive ? (item.IsConfirmed ? T("ConfirmedData") : T("NeedsConfirmation")) : T("RetiredInstallation"))</small></article> }
            </div>
        </section>
    </div>
}
<script>
(() => {
    const model = document.getElementById('Assignment_MachineModel');
    const position = document.getElementById('Assignment_MachinePositionId');
    if (!model || !position) return;
    const sync = () => {
        for (const option of position.options) {
            if (!option.dataset.machineModel) continue;
            option.hidden = option.dataset.machineModel !== model.value;
            option.disabled = option.hidden;
        }
        if (position.selectedOptions[0]?.disabled) position.value = '';
    };
    model.addEventListener('change', sync);
    sync();
})();
</script>
