@page
@model TechSupportRagBot.Pages.Admin.LicensesModel
@{
    ViewData["Title"] = TechSupportRagBot.Services.UiText.T(HttpContext, "Licenses");
}

<section class="page-head">
    <div>
        <p class="eyebrow">@TechSupportRagBot.Services.UiText.T(HttpContext, "Access")</p>
        <h1>@TechSupportRagBot.Services.UiText.T(HttpContext, "Licenses")</h1>
    </div>
</section>

@if (TempData["LicenseMailStatus"] is string mailStatus)
{
    <div class="panel" role="status">@mailStatus</div>
}
@if (TempData["LicenseRenewStatus"] is string renewStatus)
{
    <div class="panel" role="status">@renewStatus</div>
}

<div class="split-layout">
    <form method="post" class="panel">
        <h2>@TechSupportRagBot.Services.UiText.T(HttpContext, "IssueKey")</h2>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "Client")
            <select asp-for="Input.ClientId" asp-items="Model.ClientOptions"></select>
        </label>
        <p class="muted">@TechSupportRagBot.Services.UiText.T(HttpContext, "LicenseRecipientHint")</p>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "Machine")
            <select asp-for="Input.MachineId" asp-items="Model.MachineOptions"></select>
        </label>
        <label>@TechSupportRagBot.Services.UiText.T(HttpContext, "ExpiresAt")
            <input asp-for="Input.ExpiresAt" type="date" />
        </label>
        <button class="btn-main" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "CreateLicense")</button>
        <div asp-validation-summary="All" class="text-danger"></div>
    </form>

    <div class="panel">
        <h2>@TechSupportRagBot.Services.UiText.T(HttpContext, "AccessKeys")</h2>
        <div class="table-wrap">
            <table class="license-table">
                <thead>
                    <tr>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Key")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Client")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Machine")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "ExpiresAt")</th>
                        <th>@TechSupportRagBot.Services.UiText.T(HttpContext, "Status")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var license in Model.Licenses)
                {
                    <tr>
                        <td><code>@license.Key</code></td>
                        <td>@license.Client?.Name<br /><small>@license.Client?.ContactEmail</small></td>
                        <td>@license.Machine?.Name@if (!string.IsNullOrWhiteSpace(license.Machine?.SerialNumber)) { <br /><small>@TechSupportRagBot.Services.UiText.T(HttpContext, "SerialNumber"): @license.Machine.SerialNumber</small> }</td>
                        <td>@Model.ExpiryDate(license.ExpiresAt)</td>
                        <td>@(license.IsActivated ? TechSupportRagBot.Services.UiText.T(HttpContext, "Activated") : TechSupportRagBot.Services.UiText.T(HttpContext, "Issued"))</td>
                        <td>
                            <div class="license-row-actions">
                                @if (license.IsActive && license.ExpiresAt.HasValue)
                                {
                                    <button class="btn-secondary" type="button" data-license-renew
                                            data-license-id="@license.Id"
                                            data-license-machine="@license.Machine?.Name"
                                            data-license-serial="@license.Machine?.SerialNumber"
                                            data-license-min="@Model.RenewalMinDate(license.ExpiresAt.Value)">@TechSupportRagBot.Services.UiText.T(HttpContext, "RenewLicense")</button>
                                }
                                <form method="post" asp-page-handler="SendKey" asp-route-id="@license.Id" class="row-action">
                                    <button class="btn-secondary" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "SendLicenseMail")</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@license.Id" class="row-action">
                                    <button class="btn-danger" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "Delete")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="license-renew-dialog" class="license-renew-dialog" aria-labelledby="license-renew-title">
    <div class="license-renew-dialog-head">
        <h2 id="license-renew-title">@TechSupportRagBot.Services.UiText.T(HttpContext, "RenewLicenseTitle")</h2>
        <button type="button" class="license-renew-close" data-license-renew-close aria-label="@TechSupportRagBot.Services.UiText.T(HttpContext, "Cancel")">&times;</button>
    </div>
    <p id="license-renew-machine" class="muted"></p>
    <form method="post" asp-page-handler="Renew" class="license-renew-dialog-form">
        <input type="hidden" name="id" id="license-renew-id" />
        <label for="license-renew-date">@TechSupportRagBot.Services.UiText.T(HttpContext, "NewExpiryDate")</label>
        <input id="license-renew-date" name="RenewalExpiresAt" type="date" required />
        <div class="license-renew-dialog-actions">
            <button type="button" class="btn-secondary" data-license-renew-close>@TechSupportRagBot.Services.UiText.T(HttpContext, "Cancel")</button>
            <button type="submit" class="btn-main">@TechSupportRagBot.Services.UiText.T(HttpContext, "RenewLicense")</button>
        </div>
    </form>
</dialog>

<script>
(() => {
    const dialog = document.getElementById('license-renew-dialog');
    const id = document.getElementById('license-renew-id');
    const date = document.getElementById('license-renew-date');
    const machine = document.getElementById('license-renew-machine');
    document.querySelectorAll('[data-license-renew]').forEach(button => {
        button.addEventListener('click', () => {
            id.value = button.dataset.licenseId;
            date.value = '';
            date.min = button.dataset.licenseMin;
            machine.textContent = button.dataset.licenseSerial
                ? `${button.dataset.licenseMachine} · № ${button.dataset.licenseSerial}`
                : button.dataset.licenseMachine;
            dialog.showModal();
            date.focus();
        });
    });
    dialog.querySelectorAll('[data-license-renew-close]').forEach(button => {
        button.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', event => {
        if (event.target === dialog) dialog.close();
    });
})();
</script>
