@page
@model TechSupportRagBot.Pages.ErrorModel
@{
    Layout = null;
    var isEnglish = HttpContext.Request.Cookies["lang"] == "en";
    var title = TechSupportRagBot.Services.UiText.T(HttpContext, "UnexpectedErrorTitle");
}
<!doctype html>
<html lang="@(isEnglish ? "en" : "ru")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — Class Engineering</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #edf6fc; color: #173657; font-family: system-ui, sans-serif; }
        main { width: min(34rem, calc(100% - 3rem)); padding: 2rem; border-radius: 1.5rem; background: white; box-shadow: 0 16px 50px #12406a1a; }
        h1 { margin: 0 0 1rem; font-size: clamp(1.6rem, 4vw, 2.2rem); }
        p { line-height: 1.6; }
        a { display: inline-block; margin-top: 1rem; padding: .8rem 1.2rem; border-radius: .7rem; background: #168dd0; color: white; text-decoration: none; font-weight: 600; }
        small { display: block; margin-top: 1.5rem; color: #58718b; overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <main>
        <h1>@title</h1>
        <p>@TechSupportRagBot.Services.UiText.T(HttpContext, "UnexpectedErrorBody")</p>
        <a href="/">@TechSupportRagBot.Services.UiText.T(HttpContext, "ReturnHome")</a>
        @if (Model.ShowRequestId)
        {
            <small>@TechSupportRagBot.Services.UiText.T(HttpContext, "SupportRequestCode"): @Model.RequestId</small>
        }
    </main>
</body>
</html>
