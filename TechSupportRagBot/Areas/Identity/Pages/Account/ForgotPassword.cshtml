@page
@model TechSupportRagBot.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = TechSupportRagBot.Services.UiText.T(HttpContext, "Reset password");
}

<div class="auth-layout">
    <form method="post" class="auth-card">
        <p class="eyebrow">Class-Engineering Support</p>
        <h1>@TechSupportRagBot.Services.UiText.T(HttpContext, "Reset password")</h1>
        <p>@TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryRequestHint")</p>
        <label>
            @TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryEmail")
            <input asp-for="Email" type="email" autocomplete="email" required />
        </label>
        <button class="btn-main" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryRequestButton")</button>
        <a class="muted-link" asp-page="/Index" asp-area="">@TechSupportRagBot.Services.UiText.T(HttpContext, "Back to login")</a>
        <div asp-validation-summary="All" class="text-danger"></div>
    </form>
</div>
