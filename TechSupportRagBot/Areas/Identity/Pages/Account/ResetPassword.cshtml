@page
@model TechSupportRagBot.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = TechSupportRagBot.Services.UiText.T(HttpContext, "Reset password");
}

<div class="auth-layout">
    <div class="auth-card">
        <p class="eyebrow">Class-Engineering Support</p>
        <h1>@TechSupportRagBot.Services.UiText.T(HttpContext, "Reset password")</h1>
        @if (Model.PasswordChanged)
        {
            <div class="notice-success">@TechSupportRagBot.Services.UiText.T(HttpContext, "Password changed. You can sign in now.")</div>
            <a class="btn-main as-link" asp-page="/Index" asp-area="">@TechSupportRagBot.Services.UiText.T(HttpContext, "Go to login")</a>
        }
        else
        {
            <p>@TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryCodeSent")</p>
            <form method="post" asp-page-handler="@(Model.CodeVerified ? "Save" : "Verify")">
                <label>
                    @TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryEmail")
                    <input asp-for="Input.Email" type="email" autocomplete="email" readonly required />
                </label>
                @if (Model.CodeVerified)
                {
                    <input type="hidden" asp-for="Input.Code" />
                    <label>
                        @TechSupportRagBot.Services.UiText.T(HttpContext, "New password")
                        <input asp-for="Input.Password" type="password" minlength="6" autocomplete="new-password" required />
                    </label>
                    <label>
                        @TechSupportRagBot.Services.UiText.T(HttpContext, "Repeat password")
                        <input asp-for="Input.ConfirmPassword" type="password" minlength="6" autocomplete="new-password" required />
                    </label>
                }
                else
                {
                    <label>
                        @TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryCode")
                        <input asp-for="Input.Code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required />
                    </label>
                }
                <div asp-validation-summary="All" class="text-danger"></div>
                <button class="btn-main" type="submit">@TechSupportRagBot.Services.UiText.T(HttpContext, Model.CodeVerified ? "Save password" : "RecoveryVerify")</button>
            </form>
            <a class="muted-link" asp-page="./ForgotPassword">@TechSupportRagBot.Services.UiText.T(HttpContext, "RecoveryRequestAgain")</a>
        }
    </div>
</div>
